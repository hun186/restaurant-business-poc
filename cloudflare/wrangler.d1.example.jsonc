{
  "name": "restaurant-business-poc",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "restaurant-business-prod",
      "database_id": "REPLACE-WITH-PRODUCTION-D1-UUID",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "restaurant-business-staging",
        "database_id": "REPLACE-WITH-STAGING-D1-UUID"
      }
    ]
  },
  "assets": {
    "directory": "./vercel-demo",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
