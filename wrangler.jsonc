{
  "name": "restaurant-business-poc",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "restaurant-business-staging",
        "database_id": "2c355bed-d9c3-449c-aa9b-1018f3bc1177"
      }
    ],
    "vars": {
      "CLOUD_AUTH_PHASE": "preview-readonly"
    }
  },
  "assets": {
    "directory": "./vercel-demo",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "restaurant-business-prod",
      "database_id": "b882a6e8-0e56-49a6-bd41-1a6cadd726c9",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "vars": {
    "CLOUD_AUTH_PHASE": "disabled"
  }
}
